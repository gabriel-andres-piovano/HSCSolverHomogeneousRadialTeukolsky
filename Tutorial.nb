       RowBox[{"r", "^", "2"}], "-", 
       RowBox[{"2", "r"}], "+", 
       RowBox[{"a", "^", "2"}]}], ")"}], 
     RowBox[{"-", "s"}]], 
    RowBox[{"Exp", "[", 
     RowBox[{"H", " ", "I", " ", "\[Omega]", " ", 
      RowBox[{"rtor", "[", 
       RowBox[{"r", ",", "a"}], "]"}]}], "]"}], 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "m", " ", 
      RowBox[{"a", "/", 
       RowBox[{"(", 
