Cell[BoxData[{
 RowBox[{
  RowBox[{"rtor", "[", 
   RowBox[{"r_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"1", "+", 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"a", "^", "2"}]}]]}], 
