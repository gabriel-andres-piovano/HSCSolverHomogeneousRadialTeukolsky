      RowBox[{"1", "-", 
       RowBox[{"a", "^", "2"}]}]]], 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"r", "-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "-", 
           RowBox[{"a", "^", "2"}]}]]}], ")"}]}], "2"], "]"}]}], "-", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"a", "^", "2"}]}]]}], 
